<odoo>
    <record id="view_res_config_settings_inherit_credit_limit" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.credit.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_default_credit_limit']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='account_default_credit_limit']" position="after">
                <field name="credit_limit_currency_id" invisible="1"/>
                <field name="account_default_credit_limit_usd"/>
            </xpath>
        </field>
    </record>
</odoo>