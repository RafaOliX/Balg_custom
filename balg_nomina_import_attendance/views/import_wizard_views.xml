<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario del Asistente -->
    <record id="view_attendance_import_wizard_form" model="ir.ui.view">
        <field name="name">attendance.import.wizard.form</field>
        <field name="model">attendance.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Marcajes del Reloj">
                <group>
                    <group>
                        <field name="anio" />
                        <field name="mes" />
                        <field name="company_id" />
                    </group>
                    <group>
                        <field name="file_1" filename="file_1_name" />
                        <field name="file_1_name" invisible="1" />
                        <field name="file_2" filename="file_2_name" />
                        <field name="file_2_name" invisible="1" />
                    </group>
                </group>
                <footer>
                    <button name="action_import" string="Procesar Archivos" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del Asistente -->
    <record id="action_attendance_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Marcajes</field>
        <field name="res_model">attendance.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú para RRHH (con la acción directamente) -->
    <menuitem id="menu_attendance_import"
              name="Importar Marcajes"
              parent="hr.menu_hr_root"
              action="action_attendance_import_wizard"
              sequence="10"/>
</odoo>