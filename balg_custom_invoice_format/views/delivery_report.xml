<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_vertical_light" model="report.paperformat">
        <field name="name">Vertical con márgenes ligeros</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="dpi">90</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_spacing">0</field>
        <field name="header_line">False</field>
        <field name="orientation">Portrait</field>
    </record>

    <template id="custom_delivery_slip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>

                <div class="article" style="padding: 0px !important; margin: 0px !important;">

                    <div style="margin: 0px !important; padding: 5px 10px;">
                        <div class="row">
                            <div class="col-12">
                                <h3 style="margin: 0px; padding: 0px;">Cerámicas</h3>
                            </div>
                        </div>
                    </div>

                    <div style="padding: 10px;">

                        <div class="row" style="margin-bottom: 5px;">
                            <div class="col-6" name="div_outgoing_address">
                                <div t-if="o.should_print_delivery_address()">
                                    <span><strong>Dirección de envío:</strong></span>
                                    <div t-field="o.move_ids[0].partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                                </div>
                                <div t-elif="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id">
                                    <span><strong>Dirección del almacén:</strong></span>
                                    <div t-field="o.picking_type_id.warehouse_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                                </div>
                            </div>
                            <div class="col-5 offset-1" name="div_incoming_address">
                                <t t-set="show_partner" t-value="False"/>
                                <div t-if="o.picking_type_id.code=='incoming' and o.partner_id">
                                    <span><strong>Dirección del proveedor:</strong></span>
                                    <t t-set="show_partner" t-value="True"/>
                                </div>
                                <div t-if="o.picking_type_id.code=='internal' and o.partner_id">
                                    <span><strong>Dirección del almacén:</strong></span>
                                    <t t-set="show_partner" t-value="True"/>
                                </div>
                                <div t-if="o.picking_type_id.code=='outgoing' and o.partner_id and o.partner_id != o.partner_id.commercial_partner_id">
                                    <span><strong>Dirección del cliente:</strong></span>
                                    <t t-set="show_partner" t-value="True"/>
                                </div>
                                <div t-if="show_partner" name="partner_header">
                                    <div t-field="o.partner_id.commercial_partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;, &quot;vat&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                                </div>
                            </div>
                        </div>
                        
                  
<div class="row" style="margin-bottom: 5px;">
    <div class="col-6">
        <strong>Nro: </strong>
        <t t-if="o.sale_id and o.sale_id.invoice_ids">
            <span t-field="o.sale_id.invoice_ids[0].invoice_number_next"/>
        </t>
        <t t-else="">
            <span>Sin</span>
        </t>
    </div>
</div>
                        <h1 t-field="o.name" style="margin-top: 0px; margin-bottom: 5px; font-size: 24px;"/>
                        <div class="row" style="margin-bottom: 5px;">
                            <div t-if="o.origin" class="col-auto" name="div_origin">
                                <strong>Orden:</strong>
                                <p t-field="o.origin" style="margin-bottom: 0px;"/>
                            </div>
                            <div class="col-auto" name="div_state">
                                <strong>Estado:</strong>
                                <p t-field="o.state" style="margin-bottom: 0px;"/>
                            </div>
                            <div class="col-auto" name="div_sched_date">
                                <strong>Fecha programada:</strong>
                                <p t-field="o.scheduled_date" style="margin-bottom: 0px;"/>
                            </div>
                        </div>

                        

                        <table class="table table-sm" t-if="o.move_line_ids and o.move_ids_without_package" style="margin-top: 5px; width: 100%; border-collapse: collapse;">
                            <t t-set="has_barcode" t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in o.move_line_ids)"/>
                            <t t-set="has_serial_number" t-value="any(move_line.lot_id or move_line.lot_name for move_line in o.move_line_ids)" groups="stock.group_production_lot"/>
                            <thead>
                                <tr style="border-bottom: 2px solid #ddd;">
                                    <th name="th_product" style="text-align: left; padding: 5px;">
                                        <strong>Producto</strong>
                                    </th>
                                    <th style="text-align: right; padding: 5px;">
                                        <strong>Cantidad</strong>
                                    </th>
                                    <th name="th_from" t-if="o.picking_type_id.code != 'incoming'" style="text-align: left; padding: 5px;" groups="stock.group_stock_multi_locations">
                                        <strong>Desde</strong>
                                    </th>
                                    <th name="th_to" t-if="o.picking_type_id.code != 'outgoing'" style="text-align: left; padding: 5px;" groups="stock.group_stock_multi_locations">
                                        <strong>Hasta</strong>
                                    </th>
                                    <th name="th_serial_number" class="text-center" t-if="has_serial_number" style="text-align: center; padding: 5px;">
                                       <strong>Nº de lote/serie</strong>
                                    </th>
                                    <th name="th_barcode" class="text-center" t-if="has_barcode" style="text-align: center; padding: 5px;">
                                        <strong>Código de barras</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.move_line_ids_without_package.sorted(lambda ml: (ml.location_id.complete_name, ml.location_dest_id.complete_name))" t-as="ml">
                                    <tr>
                                        <td style="padding: 5px;">
                                            <span t-field="ml.product_id.display_name"/><br/>
                                            <span t-field="ml.product_id.description_picking"/>
                                        </td>
                                        <td style="text-align: right; padding: 5px;">
                                            <span t-if="o.state != 'done'" t-field="ml.reserved_uom_qty"/>
                                            <span t-if="o.state == 'done'" t-field="ml.qty_done"/>
                                            <span t-field="ml.product_uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td t-if="o.picking_type_id.code != 'incoming'" style="padding: 5px;" groups="stock.group_stock_multi_locations">
                                            <span t-esc="ml.location_id.display_name"/>
                                            <t t-if="ml.package_id">
                                                <span t-field="ml.package_id"/>
                                            </t>
                                        </td>
                                        <td t-if="o.picking_type_id.code != 'outgoing'" style="padding: 5px;" groups="stock.group_stock_multi_locations">
                                            <div>
                                                <span t-field="ml.location_dest_id"/>
                                                <t t-if="ml.result_package_id">
                                                    <span t-field="ml.result_package_id"/>
                                                </t>
                                            </div>
                                        </td>
                                        <td style="text-align: center; padding: 5px;" t-if="has_serial_number">
                                            <div t-if="has_serial_number and (ml.lot_id or ml.lot_name)" t-esc="ml.lot_id.name or ml.lot_name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 400, 'height': 100, 'img_style': 'width:100%;height:35px;'}"/>
                                        </td>
                                        <td style="text-align: center; padding: 5px;" t-if="has_barcode">
                                            <t t-if="product_barcode != ml.product_id.barcode">
                                                <span t-if="ml.product_id and ml.product_id.barcode">
                                                    <div t-field="ml.product_id.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 400, 'height': 100, 'quiet': 0, 'img_style': 'height:35px;'}"/>
                                                </span>
                                                <t t-set="product_barcode" t-value="ml.product_id.barcode"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <t t-set="totales" t-value="{}"/>
                            <t t-foreach="o.move_line_ids_without_package" t-as="ml">
                                <t t-set="uom" t-value="ml.product_uom_id.name"/>
                                <t t-set="cantidad" t-value="ml.reserved_uom_qty if o.state != 'done' else ml.qty_done"/>
                                <t t-set="totales" t-value="dict(totales, **{uom: (totales.get(uom, 0) + cantidad)})"/>
                            </t>
                            <t t-if="totales">
                                <t t-foreach="totales.items()" t-as="item">
                                    <tr style="border-top: 2px solid #000;">
                                        <td colspan="99" style="text-align: right; font-weight: bold; padding: 8px;">
                                            <span>Total <t t-esc="item[0]"/>: <t t-esc="item[1]" t-options='{"widget": "float", "precision": 2}'/></span>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </table>

                        <table class="table table-sm" t-if="o.package_level_ids and o.picking_type_entire_packs and o.state in ['assigned', 'done']" style="margin-top: 10px; width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th name="th_package" style="text-align: left; padding: 5px;">Paquete</th>
                                    <th name="th_pko_from" t-if="o.picking_type_id.code != 'incoming'" style="text-align: left; padding: 5px;" groups="stock.group_stock_multi_locations">Desde</th>
                                    <th name="th_pki_from" t-if="o.picking_type_id.code != 'outgoing'" style="text-align: left; padding: 5px;" groups="stock.group_stock_multi_locations">Hasta</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.package_level_ids.sorted(key=lambda p: p.package_id.name)" t-as="package">
                                    <t t-set="package" t-value="package.with_context(picking_id=o.id)"/>
                                    <td name="td_pk_barcode" style="padding: 5px;">
                                        <div t-field="package.package_id.name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;margin-left: -50px;'}"/><br/>
                                    </td>
                                    <td t-if="o.picking_type_id.code != 'incoming'" style="padding: 5px;" groups="stock.group_stock_multi_locations">
                                        <span t-field="package.location_id"/>
                                    </td>
                                    <td t-if="o.picking_type_id.code != 'outgoing'" style="padding: 5px;" groups="stock.group_stock_multi_locations">
                                        <span t-field="package.location_dest_id"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="o.picking_type_id.sequence_code=='OUT'" style="margin-top: 15px; padding-top: 10px; border-top: 1px solid #ccc;">
                            <div style="font-size: 14px; text-align: left;">
                                <strong>Conductor:</strong> <span t-field="o.driver"/>
                            </div>
                            <div style="font-size: 14px; text-align: left;">
                                <strong>Cédula:</strong> <span t-field="o.vat_conductor"/>
                            </div>
                            <div style="font-size: 14px; text-align: left;">
                                <strong>Placa:</strong> <span t-field="o.plate_conductor"/>
                            </div>
                        </div>

                        <t t-set="no_reserved_product" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty != x.reserved_availability and x.move_line_ids and x.state!='done')"/>
                        <p t-if="o.state in ['draft', 'waiting', 'confirmed'] or no_reserved_product" style="margin-top: 5px; margin-bottom: 0px;">
                            <i class="fa fa-exclamation-triangle"/>
                            No se pudieron reservar todos los productos. Haz clic en "Verificar disponibilidad" para intentar reservarlos.
                        </p>
                        
                        <p t-field="o.note" style="margin-top: 5px; margin-bottom: 0px;"/>

                    </div>

                </div>
            </t>
        </t>
    </template>

    <record id="action_custom_delivery_slip" model="ir.actions.report">
        <field name="name">Albarán Carente</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">balg_custom_invoice_format.custom_delivery_slip</field>
        <field name="report_file">balg_custom_invoice_format.custom_delivery_slip</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="balg_custom_invoice_format.paperformat_vertical_light"/>
    </record>

</odoo>
