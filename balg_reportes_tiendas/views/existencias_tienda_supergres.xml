<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de búsqueda -->
    <record id="view_reporte_existencias_tienda_supergres_search" model="ir.ui.view">
        <field name="name">reporte.existencias.tienda.supergres.search</field>
        <field name="model">balg_reportes_tiendas.existencias_tienda_supergres</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_producto" string="Producto"/>
                <field name="x_categoria" string="Categoría"/>
                <field name="x_unidad_medida" string="Unidad de Medida"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Categoría" name="group_categoria" context="{'group_by': 'x_categoria'}"/>
                    <filter string="Producto" name="group_producto" context="{'group_by': 'x_producto'}"/>
                    <filter string="Ubicación" name="group_ubicacion" context="{'group_by': 'x_ubicacion'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_reporte_existencias_tienda_supergres" model="ir.actions.act_window">
        <field name="name">Existencias SUPERGRES</field>
        <field name="res_model">balg_reportes_tiendas.existencias_tienda_supergres</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_reporte_existencias_tienda_supergres_search"/>
        <field name="context">{'dashboard_card': True}</field>
    </record>

</odoo>