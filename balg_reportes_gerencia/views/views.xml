        <field name="res_model">balg_reportes_gerencia.reporte_precio_promedio</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="context">{'dashboard_card': True}</field>
    </record>

    <!-- ============================================================ -->
    <!-- 3. VENTAS POR CLIENTE                                         -->
