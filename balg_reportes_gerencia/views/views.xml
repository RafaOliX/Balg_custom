    <!-- ============================================================ -->
    <!-- 6. EXISTENCIAS                                                -->
    <!-- ============================================================ -->
    <record id="action_reporte_existencias" model="ir.actions.act_window">
        <field name="name">Existencias</field>
        <field name="res_model">balg_reportes_gerencia.reporte_existencias</field>
