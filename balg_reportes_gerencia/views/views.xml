<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 1. PRODUCCIÓN %                                               -->
    <!-- ============================================================ -->
    <record id="view_produccion_porcentaje_search" model="ir.ui.view">
        <field name="name">produccion.porcentaje.search</field>
        <field name="model">balg_reportes_gerencia.reporte_produccion_porcentaje</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_fecha_movimiento" string="Fecha Movimiento" widget="date"/>
                <filter name="filter_this_month" string="Fecha de Movimiento" date="x_fecha_movimiento"/>
                <field name="x_producto" string="Producto"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Fecha Movimiento" name="group_month" context="{'group_by': 'x_fecha_movimiento:month'}"/>
                    <filter string="Producto" name="group_product" context="{'group_by': 'x_producto'}"/>
                    <filter string="Turno" name="group_turno" context="{'group_by': 'x_turno'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_produccion_porcentaje" model="ir.actions.act_window">
        <field name="name">Porcentaje de Producción</field>
        <field name="res_model">balg_reportes_gerencia.reporte_produccion_porcentaje</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_produccion_porcentaje_search"/>
        <field name="context">{'dashboard_card': True}</field>
    </record>

    <!-- ============================================================ -->
    <!-- 2. PRECIO PROMEDIO                                            -->
    <!-- ============================================================ -->
    <record id="action_reporte_precio_promedio" model="ir.actions.act_window">
