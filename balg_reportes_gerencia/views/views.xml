        <field name="arch" type="xml">
            <search>
                <field name="x_fecha_factura" string="Fecha Factura" widget="date"/>
                <filter name="filter_today" string="Hoy" date="x_fecha_factura"/>
                <filter name="filter_this_week" string="Esta semana" date="x_fecha_factura"/>
                <filter name="filter_this_month" string="Este mes" date="x_fecha_factura"/>
                <field name="x_cliente" string="Cliente"/>
                <field name="x_estado" string="Estado"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Mes" name="group_month" context="{'group_by': 'x_fecha_factura:month'}"/>
                    <filter string="Año" name="group_year" context="{'group_by': 'x_fecha_factura:year'}"/>
                    <filter string="Cliente" name="group_cliente" context="{'group_by': 'x_cliente'}"/>
                    <filter string="Producto" name="group_producto" context="{'group_by': 'x_producto'}"/>
                    <filter string="Equipo Ventas" name="group_equipo" context="{'group_by': 'x_equipo_ventas'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reporte_ventas_cliente" model="ir.actions.act_window">
        <field name="name">Ventas por Cliente</field>
        <field name="res_model">balg_reportes_gerencia.reporte_ventas_cliente</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_ventas_cliente_search"/>
