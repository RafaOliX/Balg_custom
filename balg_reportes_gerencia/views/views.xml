    </record>

    


    

    <!-- ============================================================ -->
    <!-- 7. DASHBOARD (KANBAN) Y MENÚ PRINCIPAL                       -->
    <!-- ============================================================ -->
    <record id="view_dashboard_report_kanban" model="ir.ui.view">
        <field name="name">dashboard.report.kanban</field>
        <field name="model">dashboard.report</field>
        <field name="arch" type="xml">
            <kanban class="o_dashboard_kanban" name="action_open_report" type="object">
                <field name="name"/>
                <field name="description"/>
                <field name="icon"/>
                <field name="color"/>
                <field name="action_id"/>
                <field name="sequence"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_dashboard_card"
                             t-attf-style="border-top: 5px solid #{record.color.raw_value};"
                             t-attf-class="{'oe_kanban_global_click': record.active.raw_value}">
                            <div class="o_dashboard_card_icon">
                                <i t-attf-class="fa #{record.icon.raw_value} fa-4x"
                                   t-attf-style="color: #{record.color.raw_value};"
                                   title="Icono"/>
                            </div>
                            <div class="o_dashboard_card_content" >
                                <h4><field name="name"/></h4>
                                <p><field name="description"/></p>
            <button name="action_open_report" type="object"                class="btn btn-primary btn-sm">
                                    Abrir Reporte
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_dashboard_report" model="ir.actions.act_window">
        <field name="name">Reportes Gerencia</field>
        <field name="res_model">dashboard.report</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_dashboard_report_kanban"/>
        <field name="context">{'group_by': False, 'domain': [('active', '=', True)]}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Selecciona el reporte que deseas consultar.
            </p>
        </field>
    </record>

    <menuitem id="menu_gerencia_root"
              name="Reportes Gerencia"
              action="action_dashboard_report"
              sequence="10"
              web_icon="balg_reportes_gerencia,static/description/icon.png"/>

</odoo>