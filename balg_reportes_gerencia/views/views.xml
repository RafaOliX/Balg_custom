                    <filter string="Año" name="group_year" context="{'group_by': 'x_fecha_factura:year'}"/>
                    <filter string="Serie" name="group_serie" context="{'group_by': 'x_serie'}"/>
                    <filter string="Cliente" name="group_cliente" context="{'group_by': 'x_cliente'}"/>
                    <filter string="Producto" name="group_producto" context="{'group_by': 'x_producto'}"/>
