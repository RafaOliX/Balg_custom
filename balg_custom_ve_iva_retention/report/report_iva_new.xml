<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_iva_retention_new">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
    /* Para textos de dirección y párrafos legales */
    .address-text {
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: normal;      /* permite saltos de línea */
        font-size: 11px;
        line-height: 1.2;
        max-width: 100%;
    }
    .legal-text {
        text-align: justify;
        font-size: 11px;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    /* Para tablas */
    .table-report {
        table-layout: fixed;      /* ancho fijo, no se expande con contenido */
        width: 100%;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
    .table-report th,
    .table-report td {
        word-wrap: break-word;
        overflow-wrap: break-word;
        font-size: 10px;          /* reduce un poco la fuente en celdas */
        padding: 2px;
        white-space: normal;
    }
    .table-report tr {
        page-break-inside: avoid;  /* evita cortar una fila entre páginas */
    }

    /* Para secciones que no deben dividirse */
    .signature-section {
        page-break-inside: avoid;
    }
    .header-section {
        page-break-inside: avoid;
    }
</style>
                <t t-foreach="docs" t-as="o">
                     <div class="header">
                         <div class="container">
                            <div class="row">
                                <div class="col-3 mb4">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 100px;" alt="Logo"/>
                                </div>
                                <div class="col-9">
                                    <ul class="list-inline mb4 text-center">
                                         <li style="font-size:15px;"><p><strong>COMPROBANTE DE RETENCIÓN DEL IMPUESTO AL VALOR AGREGADO</strong></p></li>
                                         <li style="font-size:12px;">
                                             <p>
                                                 DECRETO CON RANGO, VALOR Y FUERZA DE LEY DE REFORMA DE LA LEY DEL IMPUESTO AL VALOR AGREGADO N° 1.434 DEL 17 DE NOVIEMBRE DE 2014
                                                 ARTICULO 11: " LA ADMINISTRACION TRIBUTARIA PODRA DESIGNAR COMO RESPONSABLE DEL PAGO DEL IMPUESTO, EN CALIDAD DE AGENTES DE RETENCION,
                                                 A QUIENES POR FUNCIONES PUBLICAS POR RAZON DE SUS ACTIVIDADES PRIVADAS INTERVENGAN EN OPERACIONES CON EL IMPUESTO ESTABLECIDO EN ESTE DECRETO
                                                 CON RANGO, VALOR Y FUERZA DE LEY. (...) "
                                             </p>
                                         </li>
                                    </ul>
                                </div>
                            </div>
                         </div>
                     </div>
                     <div class="page">
                        <div class="container">
                            <div class="row">
                                <div class="col-8 text-left">
                                    <ul class="list-inline mb4">
                                        <li style="font-size:15px;"><strong>Nro Comprobante:</strong> <span t-field="o.name"/></li>
                                        <li style="font-size:15px;"><strong>Fecha de Emision:</strong> <span t-field="o.move_date"/></li>
