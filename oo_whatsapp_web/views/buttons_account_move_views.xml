<odoo>
    <data>
        <record model="ir.ui.view" id="oo_whatsapp_web_account_move_form_boton">
            <field name="name">oo.whatsapp.web.account.move.form.factura</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header//button[@name='action_reverse']" position="after">
                    <button
                        name="action_sendwsfactura"
                        type="object"
                        string="Enviar WhatsApp"
                        icon="fa-whatsapp"
                        attrs="{'invisible': [('state', '!=', 'posted')]}"
                    />
                </xpath>
            </field>
        </record>
    </data>
</odoo>